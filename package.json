{
  "name": "lexical-react-rte",
  "description": "Ready editor built with lexical",
  "private": false,
  "version": "0.1.72",
  "author": "Najmus Sakib <nazmusakib412@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/sakib412/lexical-react-rte#readme",
  "keywords": [
    "lexical-react",
    "lexical-react-rte",
    "react-rte",
    "lexical-playground",
    "lexical"
  ],
  "bugs": {
    "url": "https://github.com/sakib412/lexical-react-rte/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakib412/lexical-react-rte.git"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 --cache",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.16.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@lexical/code": "0.33.1",
    "@lexical/link": "0.33.1",
    "@lexical/list": "0.33.1",
    "@lexical/react": "0.33.1",
    "@lexical/rich-text": "0.33.1",
    "@lexical/selection": "0.33.1",
    "@lexical/table": "0.33.1",
    "@lexical/utils": "0.33.1",
    "lexical": "0.33.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}